# Copy this file to .env and fill in your values before running docker compose.
#   cp .env.example .env
#
# .env is intentionally listed in .gitignore — never commit real tokens.

# HuggingFace token — required to avoid rate limiting when downloading models.
# Obtain yours at https://huggingface.co/settings/tokens
HF_TOKEN=hf_YOUR_TOKEN_HERE
